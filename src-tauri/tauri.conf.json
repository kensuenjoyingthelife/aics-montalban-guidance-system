{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AICS Guidance Office",
  "version": "1.0.0",
  "identifier": "ph.edu.aicsmontalban.guidance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173?mode=staff",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AICS Montalban — Guidance Office System",
        "width": 1366,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 720,
        "maximized": true,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://mfkudukapnvbmwcfhhzn.supabase.co wss://mfkudukapnvbmwcfhhzn.supabase.co"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
